# Add these in Railway > service > Variables. Do not upload this file as an .env.
# Start with mock to verify the deployment. Change to api only after adding a
# real MOENGAGE_BRAND_CONFIG_JSON value.
MOENGAGE_MODE=mock
MAX_UPLOAD_MB=30
MOENGAGE_TIMEOUT_SECONDS=30
MOENGAGE_MAX_RETRIES=2
GOOGLE_SPREADSHEET_URL=
GOOGLE_WORKSHEET_NAME=Mastersheet
# GOOGLE_SERVICE_ACCOUNT_JSON=<paste the complete real service-account JSON>
# MOENGAGE_BRAND_CONFIG_JSON=<paste the real per-brand API configuration JSON>
MOENGAGE_DASHBOARD_URL=https://dashboard.moengage.com/
MOENGAGE_UI_CONFIG_JSON={}

# Only needed if the frontend is later deployed on a separate domain.
# Same-origin deployments do not require CORS.
# CORS_ORIGINS=https://your-frontend.example.com
