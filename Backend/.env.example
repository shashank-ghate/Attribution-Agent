MOENGAGE_MODE=browser
MAX_UPLOAD_MB=30
MOENGAGE_TIMEOUT_SECONDS=30
MOENGAGE_MAX_RETRIES=2
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STORAGE_DIR=storage

# In production, set MOENGAGE_MODE=api and add every workbook brand. Keep this
# file free of real secrets; put them in Backend/.env or your secret manager.
# The query endpoint must accept the normalized payload documented in README.md.
MOENGAGE_BRAND_CONFIG_JSON={"Aldo":{"workspace_id":"YOUR_WORKSPACE_ID","query_url":"https://YOUR_MOENGAGE_QUERY_ENDPOINT","api_key":"YOUR_API_KEY"}}

GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google-service-account.json
# Railway alternative: paste the complete service-account JSON into a sealed
# GOOGLE_SERVICE_ACCOUNT_JSON variable. Never commit the real value here.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit
GOOGLE_WORKSHEET_NAME=Mastersheet
MOENGAGE_DASHBOARD_URL=https://dashboard.moengage.com/

# Account-specific selectors captured from your MoEngage dashboard. The values
# below are examples and must be replaced after inspecting the logged-in UI.
MOENGAGE_UI_CONFIG_JSON={"query_url":"https://dashboard.moengage.com/YOUR_QUERY_PAGE","login_url_contains":"login","logged_in_selector":"[data-testid='user-menu']","brand_switcher":"[data-testid='workspace-switcher']","brand_option":"text={brand}","campaign_type":"[data-testid='campaign-type']","channel":"[data-testid='channel']","campaign_id":"[data-testid='readable-campaign-id']","start_date":"[data-testid='start-date']","end_date":"[data-testid='end-date']","metric":"[data-testid='metric']","run_query":"[data-testid='run-query']","result":"[data-testid='query-result']"}

# The recorded behavior-analysis workflow can instead use:
# MOENGAGE_UI_CONFIG_JSON={"workflow":"recorded_behavior","query_url_map":{"VS":"https://dashboard-03.moengage.com/v4/analytics/v2/behavior?did=VS_DASHBOARD_ID&chartId=VS_CHART_ID","Aldo":"https://dashboard-03.moengage.com/v4/analytics/v2/behavior?did=ALDO_DASHBOARD_ID&chartId=ALDO_CHART_ID"},"login_url_contains":"/auth/login","logged_in_selector":"text=Create New","workspace_map":{"Aldo":"AL_IN","VS":"VS_IN"}}
